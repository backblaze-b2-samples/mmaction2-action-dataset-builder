# Backblaze B2 (required) — S3-compatible API
# The S3 endpoint is derived from B2_REGION as https://s3.<region>.backblazeb2.com,
# so there is no endpoint URL to set here.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004
# Optional: public bucket base URL for building direct object links.
# Leave empty if your bucket is private (the app uses presigned URLs instead).
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K000xxxxxxxxxxxxxxxxxxxxxxxxxxx
# B2_BUCKET_NAME=my-action-datasets
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-action-datasets.s3.us-west-004.backblazeb2.com
